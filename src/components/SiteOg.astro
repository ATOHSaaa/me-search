---
interface Props {
	title?: string;
	description?: string;
}

const {
	title = '.me search',
	description = '個人サイトやポートフォリオサイトなどを掲載するギャラリーサイト。',
} = Astro.props;

const site = Astro.site ?? (import.meta.env.SITE ? new URL(import.meta.env.SITE) : undefined);
const base = import.meta.env.BASE_URL;
const pageUrl = site
	? new URL(Astro.url.pathname, site).href
	: undefined;
const ogImage = site ? new URL(`${base}og-image.png`, site).href : `${base}og-image.png`;
---

<meta name="description" content={description} />
{pageUrl ? <link rel="canonical" href={pageUrl} /> : null}
<meta property="og:type" content="website" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
{pageUrl ? <meta property="og:url" content={pageUrl} /> : null}
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={title} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />