---
import { resolveOgImageUrl } from '../lib/ogImage';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = '.me search',
	description = '個人サイトやポートフォリオサイトなどを掲載するギャラリーサイト。',
} = Astro.props;

const site = Astro.site ?? (import.meta.env.SITE ? new URL(import.meta.env.SITE) : undefined);
const origin = site ?? Astro.url;
const pageUrl = site ? new URL(Astro.url.pathname, site).href : undefined;
const ogImage = await resolveOgImageUrl(origin);
---

<meta name="description" content={description} />
{pageUrl ? <link rel="canonical" href={pageUrl} /> : null}
<meta property="og:type" content="website" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
{pageUrl ? <meta property="og:url" content={pageUrl} /> : null}
<meta property="og:image" content={ogImage.url} />
<meta property="og:image:width" content={String(ogImage.width)} />
<meta property="og:image:height" content={String(ogImage.height)} />
<meta property="og:image:alt" content={title} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage.url} />